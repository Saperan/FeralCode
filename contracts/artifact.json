{
  "name": "artifact-delivery",
  "match": "(?:build|implement|create|write|add|fix|refactor|script|page|route|api|component|function)",
  "required": [
    {
      "id": "A",
      "desc": "A complete code block, not a one-line fragment.",
      "test": "```[\\s\\S]{40,}?```",
      "min_length": 200
    },
    {
      "id": "B",
      "desc": "A concrete file, path, route, or endpoint.",
      "test": "(?:\\.(?:ts|tsx|js|jsx|py|go|rs|html|css|json|md)\\b|(?:file|path|route|endpoint|field)\\s*[:=]|(?:GET|POST)\\s+\\S+)"
    },
    {
      "id": "C",
      "desc": "Wiring from the artifact to the runtime.",
      "test": "(?:app\\.(?:get|post|use)|router\\.(?:get|post|use)|action\\s*=\\s*[\"'][^\"'#]|addEventListener\\s*\\(\\s*[\"']submit|fetch\\s*\\()"
    }
  ],
  "retry": 3
}
